<Window x:Class="MovieLibraryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movie Library Management System"
        Height="700"
        Width="1100">

    <Grid Margin="10">
        <TabControl>

            <TabItem Header="Add Movie">
                <Grid Margin="20">

                    <StackPanel Width="350">

                        <TextBlock Text="Movie ID"/>
                        <TextBox x:Name="MovieIDTextBox"
                                 Text="Example: M009"/>

                        <TextBlock Text="Title"/>
                        <TextBox x:Name="TitleTextBox"
                                 Text="Example: New Movie"/>

                        <TextBlock Text="Director"/>
                        <TextBox x:Name="DirectorTextBox"
                                 Text="Example: Director"/>

                        <TextBlock Text="Genre"/>
                        <TextBox x:Name="GenreTextBox"
                                 Text="Example: Sci-Fi"/>

                        <TextBlock Text="Release Year"/>
                        <TextBox x:Name="YearTextBox"
                                 Text="Example: 2026"/>

                        <Button Content="Add Movie"
                                Click="AddMovie_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Movie Library">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel>

                        <TextBox x:Name="SearchTextBox"
                                 Width="180"
                                 Text="Example: M001 or Inception"/>

                        <Button Content="Search Title"
                                Click="SearchTitle_Click"/>

                        <Button Content="Search ID"
                                Click="SearchID_Click"/>

                        <Button Content="Show All"
                                Click="ShowAll_Click"/>

                        <Button Content="Sort by Title"
                                Click="SortTitle_Click"/>

                        <Button Content="Sort by Year"
                                Click="SortYear_Click"/>

                        <TextBox x:Name="BorrowMovieTextBox"
                                 Width="180"
                                 Text="Movie ID or Title"/>

                        <TextBox x:Name="BorrowerTextBox"
                                 Width="140"
                                 Text="Example: John"/>

                        <Button Content="Borrow"
                                Click="Borrow_Click"/>

                        <Button Content="Return"
                                Click="Return_Click"/>
                    </WrapPanel>

                    <DataGrid x:Name="MoviesDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="True"/>
                </Grid>
            </TabItem>

            <TabItem Header="Queue">

                <Grid Margin="10">

                    <Button Content="Refresh Queue"
                            Click="RefreshQueue_Click"/>

                    <DataGrid x:Name="QueueDataGrid"
                              Margin="0,40,0,0"
                              AutoGenerateColumns="True"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
